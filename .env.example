# ============================================
# PlaceMentor AI — Environment Configuration Template
# Duplicate this file as .env or .env.local and fill in your credentials
# ============================================

# Firebase Web Client Configuration (Frontend)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# Firebase Cloud Messaging (FCM) Web Push VAPID Public Key (Frontend)
# Generated in: Firebase Console > Project Settings > Cloud Messaging > Web configuration > Web Push certificates
VITE_FIREBASE_VAPID_KEY=your_public_vapid_key_here

# Google Gemini API Key (Frontend)
# Generated in: Google AI Studio (https://aistudio.google.com/app/apikey)
# Powers Dr. Elena Rostova AI Placement Mentor
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# Server-Side Configuration (Vercel Serverless & n8n)
# DO NOT PREFIX WITH VITE_ (Keeps these strictly private on the server)
# Set these in your Vercel Project Settings > Environment Variables
# ============================================

# Secret shared between n8n and PlaceMentor AI backend (Header: x-api-key)
N8N_PUSH_SECRET=generate_a_random_secure_hex_or_uuid_string_here

# n8n Production Job Alert Webhook URL
# Triggered by PlaceMentor AI whenever a new verified job/internship is published
N8N_JOB_WEBHOOK_URL=https://fahu.app.n8n.cloud/webhook/placmentor-job-alert

# Optional secret for n8n webhook authentication (Header: x-webhook-secret)
N8N_JOB_WEBHOOK_SECRET=your_optional_n8n_webhook_secret_here

# Firebase Admin Service Account Key (JSON String)
# Generated in: Firebase Console > Project Settings > Service accounts > Generate new private key
# Paste the entire single-line JSON string here:
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"your_project_id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-...@your_project_id.iam.gserviceaccount.com"}

# Alternatively, configure discrete variables instead of FIREBASE_SERVICE_ACCOUNT_KEY:
# FIREBASE_PROJECT_ID=your_project_id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...==\n-----END PRIVATE KEY-----\n"
